# ORENZA server-side configuration template.
# NEVER commit real values. Keep production values in Vercel/Supabase secret configuration.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_WITH_PUBLIC_ANON_KEY
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=REPLACE_WITH_SERVER_ONLY_SECRET

# Deriv OAuth 2.0
DERIV_APP_ID=REPLACE_WITH_DERIV_APP_ID
DERIV_CLIENT_ID=REPLACE_WITH_DERIV_OAUTH_CLIENT_ID
DERIV_CLIENT_SECRET=REPLACE_WITH_DERIV_CLIENT_SECRET_IF_ISSUED
DERIV_REDIRECT_URI=https://YOUR_DOMAIN.example/api/deriv/oauth/callback
DERIV_OAUTH_SCOPES=trade

# ORENZA OAuth/session security
ORENZA_APP_URL=https://YOUR_DOMAIN.example
ORENZA_OAUTH_STATE_SECRET=REPLACE_WITH_LONG_RANDOM_SERVER_SECRET
FIELD_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_KEY_BASE64_OR_64_HEX_CHARS

# Provider chain gates: keep locked until separately authorized and verified.
ORENZA_PROVIDER_ENVIRONMENT=DEMO
ORENZA_LIVE_AUTHORIZED=false
ORENZA_LIVE_MARKET_DATA_ENABLED=false
ORENZA_LIVE_TRADING_ENABLED=false
ORENZA_LIVE_PAYOUT_ENABLED=false

# Paystack TEST integration only. Never use sk_live_* here.
PAYSTACK_ENVIRONMENT=TEST
PAYSTACK_SECRET_KEY=sk_test_REPLACE_WITH_SERVER_ONLY_TEST_KEY
PAYSTACK_WEBHOOK_SECRET=sk_test_REPLACE_WITH_TEST_WEBHOOK_SECRET
PAYSTACK_TEST_CALLBACK_URL=https://YOUR_DOMAIN.example/payments/paystack/callback

# MT5 server-side bridge (optional; never expose to browser)
MT5_ENVIRONMENT=DEMO
MT5_BRIDGE_URL=https://YOUR_MT5_BRIDGE.example
MT5_BRIDGE_TOKEN=REPLACE_WITH_SERVER_ONLY_TOKEN
MT5_ACCOUNT_ID=REPLACE_WITH_ACCOUNT_ID
MT5_TRADING_ENABLED=false

# Generic payout-provider secrets are configured only when an approved adapter is enabled.
# Use provider-specific server-side names; do not hard-code a provider into ORENZA core.
# PAYOUT_PROVIDER_*_API_KEY=...
# PAYOUT_PROVIDER_*_API_SECRET=...
# PAYOUT_PROVIDER_*_WEBHOOK_SECRET=...
